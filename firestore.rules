rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE HARDENED PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 150 &&
             data.university is string && data.university.size() <= 200 &&
             (!('course' in data) || (data.course is string && data.course.size() <= 200)) &&
             (!('school' in data) || (data.school is string && data.school.size() <= 200)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('status' in data) || data.status in ['online', 'offline', 'studying', 'in_class']) &&
             (!('visibility' in data) || data.visibility in ['public', 'university_only', 'friends_only', 'private']);
    }

    function isValidGroup(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
             data.category is string && data.category in ['study_group', 'project_team', 'networking_circle', 'friend_group'] &&
             data.university is string && data.university.size() <= 200 &&
             data.creatorId is string && data.creatorId.size() <= 128 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1500));
    }

    function isValidMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.senderId is string && data.senderId == request.auth.uid &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000 &&
             (!('recipientId' in data) || (data.recipientId is string && data.recipientId.size() <= 128)) &&
             (!('groupId' in data) || (data.groupId is string && data.groupId.size() <= 128));
    }

    function isValidEvent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
             data.university is string && data.university.size() <= 200 &&
             data.organizerId is string && data.organizerId == request.auth.uid &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    function isValidResource(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.groupId is string && data.groupId.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
             data.uploadedBy is string && data.uploadedBy == request.auth.uid;
    }

    function isValidTask(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.groupId is string && data.groupId.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
             data.status in ['todo', 'in_progress', 'done'];
    }

    // --- COLLECTION RULES ---

    // 1. Student Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().email == existing().email;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 2. Study Groups & Project Circles
    match /groups/{groupId} {
      allow get: if isSignedIn() && isValidId(groupId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(groupId) && isValidGroup(incoming()) && incoming().creatorId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(groupId) && isValidGroup(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().creatorId == existing().creatorId;
      allow delete: if isSignedIn() && isValidId(groupId) && existing().creatorId == request.auth.uid;

      // Group Members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn() && isValidId(groupId);
        allow write: if isSignedIn() && isValidId(groupId) && isValidId(memberId);
      }
    }

    // 3. Encrypted Messages
    match /messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming());
      allow update: if isSignedIn() && isValidId(messageId) && (
        existing().senderId == request.auth.uid ||
        existing().recipientId == request.auth.uid
      );
      allow delete: if isSignedIn() && isValidId(messageId) && existing().senderId == request.auth.uid;
    }

    // 4. Academic Events & Study Sessions
    match /events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(eventId) && isValidEvent(incoming());
      allow update: if isSignedIn() && isValidId(eventId) && (
        existing().organizerId == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['attendees', 'remindersSet'])
      );
      allow delete: if isSignedIn() && isValidId(eventId) && existing().organizerId == request.auth.uid;
    }

    // 5. Shared Study Resources
    match /resources/{resourceId} {
      allow get: if isSignedIn() && isValidId(resourceId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(resourceId) && isValidResource(incoming());
      allow update: if isSignedIn() && isValidId(resourceId) && (
        existing().uploadedBy == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['downloadCount'])
      );
      allow delete: if isSignedIn() && isValidId(resourceId) && existing().uploadedBy == request.auth.uid;
    }

    // 6. Collaborative Tasks
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming());
      allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(taskId);
    }
  }
}
